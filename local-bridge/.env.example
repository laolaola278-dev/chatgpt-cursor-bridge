# ChatGPT Cursor Bridge - Local Bridge Service configuration
# Copy this file to `.env` and adjust the values for your machine.

# Bind address of the local bridge. Keep it on loopback.
BRIDGE_HOST=127.0.0.1
BRIDGE_PORT=8765

# Sandbox root. Every file operation is restricted to this directory.
# Relative paths are resolved against the `local-bridge/` directory.
WORKSPACE_ROOT=../workspace/projects

# JSONL audit log directory (audit.jsonl is created inside).
LOG_PATH=../workspace/logs

# Project memory root. Each project gets its own `<MEMORY_ROOT>/<project>/`.
MEMORY_ROOT=../workspace/memory

# Workflow orchestration storage (JSON files, one per workflow).
WORKFLOW_ROOT=../workspace/workflows

# Pre-execution snapshots used by stage rollback.
ROLLBACK_ROOT=../workspace/rollback

# Approved test command limits.
TEST_TIMEOUT_SECONDS=300
TEST_MAX_OUTPUT_KB=64

# Read/write payload limit in megabytes.
MAX_FILE_SIZE_MB=5

# Maximum size of a single memory append / ADR entry, in kilobytes.
MAX_MEMORY_APPEND_KB=64

# Project tree limits.
MAX_TREE_DEPTH=6
MAX_TREE_ENTRIES=2000

# Comma separated directory/file names skipped while scanning project trees.
IGNORED_NAMES=node_modules,.git,.venv,venv,__pycache__,dist,build,.next
